# Copy to .env (git-ignored) to change defaults. npm start / serve / dev / app read it automatically.
# Everything here is optional.

# Where the database, generated files, logs and backups live. Default: ./data
# DAF_DATA_DIR=/Users/you/DigitalAssetFactory

# Port for the local web interface (always bound to 127.0.0.1). Default: 4317
# DAF_PORT=4317

# info (default) or debug
# DAF_LOG_LEVEL=info

# Where API keys are kept:
#   (unset)  macOS Keychain on a Mac; on Windows, encrypted for your Windows account in data/secrets.dpapi.json  ← recommended
#   env      read DAF_SECRET_<NAME> variables below; keys cannot be changed from Settings
#   memory   kept in memory only and forgotten on restart (testing)
# DAF_SECRET_STORE=

# Keychain service name the keys are stored under. Default: digital-asset-factory
# DAF_KEYCHAIN_SERVICE=digital-asset-factory

# Read when DAF_SECRET_STORE=env, and as a fallback for any key not saved in the app.
# Prefer entering keys in Settings → AI providers, which stores them in the Keychain.
# Text generation uses whichever one is picked in Settings → Generation → Text provider;
# only one of these needs a key. OpenRouter/Groq/NVIDIA NIM/Cerebras/Together AI have each had
# a free tier, but check their own pricing pages — availability changes on their side, not this app's.
# DAF_SECRET_ANTHROPIC_API_KEY=
# DAF_SECRET_OPENROUTER_API_KEY=
# DAF_SECRET_GROQ_API_KEY=
# DAF_SECRET_NVIDIA_API_KEY=
# DAF_SECRET_CEREBRAS_API_KEY=
# DAF_SECRET_TOGETHER_API_KEY=
# DAF_SECRET_GEMINI_API_KEY=
# DAF_SECRET_MISTRAL_API_KEY=
# DAF_SECRET_GITHUB_MODELS_TOKEN=
# DAF_SECRET_HUGGINGFACE_TOKEN=
# DAF_SECRET_OPENAI_API_KEY=
# DAF_SECRET_GUMROAD_TOKEN=
# DAF_SECRET_TAVILY_API_KEY=
# DAF_SECRET_EXA_API_KEY=
# DAF_SECRET_BRAVE_SEARCH_API_KEY=
# DAF_SECRET_SMTP_PASSWORD=

# Lets the Vite dev server (npm run dev:web on :5173) call the API. Development only.
# DAF_DEV=1
